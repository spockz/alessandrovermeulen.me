{{/* Preserve the legacy Atom subscription endpoint and publish only the writing archive. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ .Site.Title }}</title>
  <id>{{ .Site.BaseURL }}</id>
  <link href="{{ .Site.BaseURL }}" />
  {{ with .OutputFormats.Get "RSS" }}<link href="{{ .Permalink }}" rel="self" type="application/atom+xml" />{{ end }}
  {{ $posts := where .Site.RegularPages "Section" "posts" }}
  <updated>{{ with $posts.ByDate.Reverse }}{{ (index . 0).Date.UTC.Format "2006-01-02T15:04:05Z07:00" }}{{ else }}{{ now.UTC.Format "2006-01-02T15:04:05Z07:00" }}{{ end }}</updated>
  <author><name>{{ .Site.Language.Params.author.name }}</name></author>
  {{ range $posts.ByDate.Reverse }}
  <entry>
    <title>{{ .Title }}</title>
    <id>{{ .Permalink }}</id>
    <link href="{{ .Permalink }}" />
    <published>{{ .Date.UTC.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.UTC.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <content type="html">{{ .Content | htmlEscape | safeHTML }}</content>
  </entry>
  {{ end }}
</feed>
