// This standalone module keeps typography tooling dependencies out of Hugo's theme module.
module github.com/spockz/alessandrovermeulen.me/scripts/typography

go 1.26.0

require (
	github.com/go-text/typesetting v0.3.5
	github.com/speedata/hyphenation v1.0.3
	golang.org/x/image v0.23.0
	golang.org/x/net v0.59.0
)
